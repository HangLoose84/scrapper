# Token que te da @BotFather al crear el bot
TELEGRAM_TOKEN=123456789:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA

# Chat al que se envían las alertas. En un chat privado coincide con tu user id.
TELEGRAM_CHAT_ID=123456789

# El ÚNICO usuario que puede usar /menu. Cualquier otro es ignorado en silencio.
TELEGRAM_OWNER_ID=123456789

# Caída mínima frente a la mediana histórica para disparar alerta. 0.15 = 15%
DROP_THRESHOLD=0.15

# Cada cuántos segundos se revisa cada target
POLL_SECONDS=60

# Cuántas observaciones pasadas entran en la mediana
HISTORY_SIZE=20
